{
    "version":2,
    "framework": null,
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.6.1"
        }
    },
    "routes": [
        {
          "src": "/(.*)",
          "dest": "/api/index.php"
        }
    ],
    "public": true,
    "buildCommand": "vite build",
    "outputDirectory": "public",
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "https://project-tax-php.vercel.app",
        "API_KEY": "base64:d8JnVMVapqETxEoqiBfb6G22ql4Q3CzEKC2/fnkv+0A=",
 
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
 
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",

        "DB_CONNECTION": "mysql",
        "DB_HOST":"127.0.0.1",
        "DB_PORT":"3306",
        "DB_DATABASE":"laravel",
        "DB_USERNAME":"root"
    }
  }